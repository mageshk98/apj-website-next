# Google Places API (New) — used by /api/google-reviews for the testimonials
# section. Both values are SERVER-SIDE ONLY: never prefix them with VITE_,
# or the key would be bundled into the browser build.

# Cloud console > APIs & Services > Credentials. Enable "Places API (New)"
# and restrict the key to that API.
GOOGLE_MAPS_API_KEY=

# The Place ID for ANBU POWER JUNCTION, Neelankarai, Chennai.
# Find it with the Place ID Finder: https://developers.google.com/maps/documentation/places/web-service/place-id
# (search the business name, then copy the ID beginning with "ChIJ").
GOOGLE_PLACE_ID=
